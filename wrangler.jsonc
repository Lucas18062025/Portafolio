{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portafolio",
  "compatibility_date": "2026-07-23",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "."
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
  // Worker name, must match the one already deployed in Cloudflare dashboard
  "name": "portafolio",
  "compatibility_date": "2026-07-01",
  // Tells Cloudflare this is a static site served from the repo root
  "assets": {
    "directory": "./"
  }
}
