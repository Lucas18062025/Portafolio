{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portafolio",
  "main": "worker.js",
  "compatibility_date": "2026-07-23",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "issues": {
      "enabled": true
    }
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
