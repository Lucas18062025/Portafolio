/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; img-src 'self' data: https:; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://skillicons.dev https://cdn.simpleicons.org; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; report-uri /api/csp-report; report-to csp-endpoint
  Report-To: {"group":"csp-endpoint","max_age":86400,"endpoints":[{"url":"/api/csp-report"}]}
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Origin-Agent-Cluster: ?1
  X-Permitted-Cross-Domain-Policies: none

# HTML y contenido dinámico: corto (5 min). Cada ruta matchea UNA sola
# regla de Cache-Control, asi Cloudflare no fusiona dos valores.
/
  Cache-Control: public, max-age=300, must-revalidate

/blog/*
  Cache-Control: public, max-age=300, must-revalidate

/data/*
  Cache-Control: public, max-age=300, must-revalidate

/404.html
  Cache-Control: public, max-age=300, must-revalidate

/404
  Cache-Control: public, max-age=300, must-revalidate

# Documentos de descubrimiento: 1 hora.
/manifest.json
  Cache-Control: public, max-age=3600, must-revalidate

/sitemap.xml
  Cache-Control: public, max-age=3600, must-revalidate

/robots.txt
  Cache-Control: public, max-age=3600, must-revalidate

/.well-known/*
  Cache-Control: public, max-age=3600, must-revalidate

/google0cbe515c88088343.html
  Cache-Control: public, max-age=3600, must-revalidate

# CSS/JS versionados con ?v=: 1 hora.
/css/*
  Cache-Control: public, max-age=3600, must-revalidate

/js/*
  Cache-Control: public, max-age=3600, must-revalidate

# Inmutables (no cambian sin cambiar de nombre): 1 anio.
# NOTA: no existe bloque /assets/* generico a proposito.
/assets/projects/*
  Cache-Control: public, max-age=31536000, immutable

/assets/og/*
  Cache-Control: public, max-age=31536000, immutable

/assets/icons/*
  Cache-Control: public, max-age=31536000, immutable

/assets/vendor/*
  Cache-Control: public, max-age=31536000, immutable

/assets/blog/*
  Cache-Control: public, max-age=31536000, immutable

/assets/hero_bg_dark_luxury.webp
  Cache-Control: public, max-age=31536000, immutable

# Hero robot v2 (P0a 17/10): antes /assets/hero-robot.webp no tenia regla y salia
# con max-age=0 -> el recurso mas pesado del hero se revalidaba en CADA visita.
/assets/hero-robot-v2-360.webp
  Cache-Control: public, max-age=31536000, immutable

/assets/hero-robot-v2-720.webp
  Cache-Control: public, max-age=31536000, immutable

/assets/hero-robot-v2-360.avif
  Cache-Control: public, max-age=31536000, immutable

/assets/hero-robot-v2-720.avif
  Cache-Control: public, max-age=31536000, immutable

# Parche del parpadeo (20/10): canvas 720x505 con los ojos apagados, se superpone
# al base. Inmutable: el nombre no cambia, si el parche se regenera hay que
# versionar el nombre (v2) o cambiar la regla a must-revalidate.
# NOTA: el CDN ignora el query string en la clave de cache, asi que un ?v=N
# NO invalida este asset: solo sirve cambiar el nombre del archivo.
/assets/hero-robot-blink-720.webp
  Cache-Control: public, max-age=31536000, immutable

/Foto_Perfil.webp
  Cache-Control: public, max-age=31536000, immutable

/Foto_Perfil-320.webp
  Cache-Control: public, max-age=31536000, immutable

/favicon.ico
  Cache-Control: public, max-age=86400, must-revalidate

# Documentos que se actualizan (CV, certificados): 1 dia.
/assets/cv/*
  Cache-Control: public, max-age=86400, must-revalidate

/assets/certificates/*
  Cache-Control: public, max-age=86400, must-revalidate
